#!/bin/bash
# ctsm.env -- shared settings for all CTSM CONUS SIF-T project cases, and the
# only place for paths and the account code in shell scripts.
# The setup and tools scripts source it themselves. Source it by hand before
# submitting a PBS job, which takes the account (and log folder) at submit time:
#   source setup/ctsm.env
#   qsub -A "$PROJECT" -o "$OUTPUT_ROOT/<folder>/" <job>.pbs

export PROJECT="P93300041"
export COMPILER="intel"
export DRIVER="nuopc"
export RES="nldas2_nldas2_rMERIT_mnldas2"
export QUEUE="main"
export MACHINE="derecho"

# Base compset for SP-mode configs (control, irrigation, hillslope)
export COMPSET_SP="I2000Clm60SpMizGsNldas"

# Base compset for BGC-mode configs (prognostic phenology)
# Added manually to config_compsets.xml in the prog_phenology worktree --
# swap SP->BGC from COMPSET_SP, following the same Miz/Gs/Nldas pattern.

# --- paths ---
export SCRATCH="/glade/derecho/scratch/mozhgana"     # case run folders: $SCRATCH/<case>/run
export ARCHIVE="$SCRATCH/archive"                    # st_archive output: $ARCHIVE/<case>/{lnd,rof,rest}
export CIME_SCRIPTS="/glade/work/mozhgana/ctsm_conus/cime/scripts"   # run setup_*.sh from here
# Same folder as OUTPUT_ROOT in analysis/config/paths.py: keep the two in sync.
export OUTPUT_ROOT="/glade/work/mozhgana/ctsm_conus_output"
# Land-use, surface and hillslope files generated by Sean Swenson: the original
# on his scratch (used by setup_landcover.sh) and the backup copy (used by the
# hillslope setups). The strings are written into user_nl_clm as they are.
export SEAN_FILES_SCRATCH="/glade/derecho/scratch/swensosc/for_mozhgan"
export SEAN_FILES_COPY="/glade/u/home/mozhgana/mywork/ctsm_conus_setup/for_mozhgan"

echo "ctsm.env loaded: PROJECT=$PROJECT, RES=$RES, MACHINE=$MACHINE"