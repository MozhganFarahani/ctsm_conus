#!/bin/bash
#PBS -N ctsm_clim
#PBS -q casper
#PBS -l select=1:ncpus=8:mem=80GB
#PBS -l walltime=03:00:00
#PBS -j oe
#
# Rebuild the control climatology cache and all maps (ctsm_climatology_maps.py --rebuild).
# Inputs : control h0a files; paths from analysis/config/paths.py
# Outputs: <output root>/climatology/ (cache and maps/); the log goes to the -o folder
# Submit from this folder; the account and log folder come from setup/ctsm.env:
#   source setup/ctsm.env                       # from the repo root
#   cd analysis/climatology && qsub -A "$PROJECT" -o "$OUTPUT_ROOT/climatology/" run_ctsm_climatology.pbs

set -euo pipefail
cd "$PBS_O_WORKDIR"

module load conda
conda activate npl-2026a

# keep BLAS/OpenMP from oversubscribing the 8 cpus dask is already using
export OMP_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export MKL_NUM_THREADS=1

# stage 1 is the expensive part: 445 files x ~44 fields, then one cache write.
# stage 2 replots from the cache and is cheap.
python -u ctsm_climatology_maps.py --rebuild

echo "done: $(date)"
