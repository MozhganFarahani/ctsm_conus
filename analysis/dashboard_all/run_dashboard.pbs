#!/bin/bash
#PBS -N ctsm_dashboard
#PBS -A P93300041
#PBS -q casper
#PBS -l select=1:ncpus=10:mem=100GB
#PBS -l walltime=06:00:00
#PBS -j oe
#PBS -o /glade/work/mozhgana/ctsm_conus_analysis/dashboard_all/logs/
#
# Build the multi-configuration dashboard for ALL gauges.
#
#   qsub run_dashboard.pbs
#   qsub -v CONFIGS=control,irrigation_on run_dashboard.pbs
#
# This is ONE job producing ONE file containing every configuration -- not
# one job per config as the earlier version was. Add hillslope_eval and
# prog_phenology to CONFIGS when those runs finish and resubmit; the upstream
# weight matrix is cached, so only the new configs' files get read.
#
# Runtime is dominated by opening ~450 h0 files and ~450 mizuRoute files per
# configuration, not by gauge count, so 3 configs is roughly 3x the single
# config case. 6 hours is generous headroom.

set -euo pipefail

CONFIGS=${CONFIGS:-control,irrigation_on,evolving_landcover,prog_phenology,hillslope_eval}
WORKDIR=/glade/work/mozhgana/ctsm_conus_analysis/dashboard_all
ARCHIVE=/glade/derecho/scratch/mozhgana/archive
RUNROOT=/glade/derecho/scratch/mozhgana      # for each config's finidat

export CACHE_DIR=$WORKDIR/cache
mkdir -p "$WORKDIR/logs" "$WORKDIR/dashboard" "$CACHE_DIR"

module load conda
conda activate npl-2026a
cd "$WORKDIR"

echo "=== $CONFIGS === $(date)"
echo "host: $(hostname)"

python build_streamflow_dashboard.py \
    --archive-root "$ARCHIVE" \
    --configs "$CONFIGS" \
    --run-root "$RUNROOT" \
    --outdir "$WORKDIR/dashboard" \
    --parallel

echo "=== done $(date) ==="
ls -lh "$WORKDIR/dashboard/"*_dashboard.html
