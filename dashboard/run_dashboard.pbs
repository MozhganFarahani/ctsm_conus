#!/bin/bash
#PBS -N ctsm_dashboard
#PBS -q casper
#PBS -l select=1:ncpus=10:mem=100GB
#PBS -l walltime=06:00:00
#PBS -j oe
#
# Build the multi-configuration dashboard for ALL gauges (build_streamflow_dashboard.py).
# Inputs : land and mizuRoute history of each config, observed flow, crosswalk,
#          routing topology and weights; paths from analysis/config/paths.py
# Outputs: <output root>/dashboard/<name>_dashboard.html (paths.DASHBOARD_OUT)
# Submit from this folder; the account and log folder come from setup/ctsm.env:
#   source setup/ctsm.env                       # from the repo root
#   cd dashboard && qsub -A "$PROJECT" -o "$OUTPUT_ROOT/dashboard/" run_dashboard.pbs
#   qsub -A "$PROJECT" -o "$OUTPUT_ROOT/dashboard/" -v CONFIGS=control,irrigation_on run_dashboard.pbs
#
# This is ONE job producing ONE file containing every configuration -- not
# one job per config as the earlier version was. Add hillslope_eval and
# prog_phenology to CONFIGS when those runs finish and resubmit; the upstream
# weight matrix is cached, so only the new configs' files get read.
#
# Runtime is dominated by opening ~450 h0 files and ~450 mizuRoute files per
# configuration, not by gauge count, so 3 configs is roughly 3x the single
# config case. 6 hours is generous headroom.

set -euo pipefail

CONFIGS=${CONFIGS:-control,irrigation_on,evolving_landcover,prog_phenology,hillslope_eval}
# Archive, run root, weight cache and output folder (--outdir default,
# paths.DASHBOARD_OUT) come from analysis/config/paths.py.

module load conda
conda activate npl-2026a
cd "$PBS_O_WORKDIR"

echo "=== $CONFIGS === $(date)"
echo "host: $(hostname)"

python build_streamflow_dashboard.py \
    --configs "$CONFIGS" \
    --parallel

echo "=== done $(date) ==="
